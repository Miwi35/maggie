# Defaults for the deterministic e2e stack (docker-compose.e2e.yml).
#
# Committed on purpose: nothing here is a secret, and `bin/console --env=e2e`
# has to work outside Compose too. Every value the stack computes at runtime —
# the resolved host port, the Compose project name — is overridden there.
#
# This environment exists so the test login (POST /api/auth/e2e/login) and the
# seed command (app:e2e:seed) have somewhere to be mounted that is neither
# `prod` nor the PHPUnit `test` environment. See
# agent-os/specs/2026-09-30-1700-e2e-environment/shape.md.

APP_ENV=e2e
# Off on purpose: several past regressions were prod-only (container
# compilation, cache pools, serialization). Diagnosis goes through
# `task e2e:logs`, not through the profiler.
APP_DEBUG=0
APP_SECRET=e2e-secret-not-used-outside-the-test-stack

DATABASE_URL="postgresql://maggie:maggie@database:5432/maggie_e2e?serverVersion=17&charset=utf8"

# Real RabbitMQ and a real worker: an e2e run that dispatched synchronously
# would not exercise the async path the journeys are there to check.
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages

MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost/.well-known/mercure
MERCURE_JWT_SECRET=e2e-mercure-secret

ELASTICSEARCH_URL=http://elasticsearch:9200
CIQUAL_SERVICE_URL=http://ciqual:8002

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
ADMIN_URL=http://localhost/admin

# Google sign-in is replaced by the test login in e2e, so these are never used.
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback
GOOGLE_WEBHOOK_URL=http://localhost/api/calendar/google/webhook
GOOGLE_WEBHOOK_TOKEN=e2e-webhook-token

# Calendar and Tasks do have callers (MAG-100), so they point at WireMock.
# Empty in dev and prod, which leaves the library's own root URL.
GOOGLE_API_BASE_URL=http://wiremock:8080/google/

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/e2e/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/e2e/public.pem
JWT_PASSPHRASE=e2e-jwt-passphrase

SERVICE_TOKEN=e2e-service-token

# Shared secret the test login demands. Committed, and the Compose file falls
# back to it — so every stack shares this value unless you export your own.
# What keeps it harmless is that the stack publishes its port on the loopback
# only. Export E2E_LOGIN_TOKEN before `task e2e:up` if that ever stops being
# true for you.
E2E_LOGIN_TOKEN=e2e-login-token

ENABLE_BANKING_APPLICATION_ID=e2e-application-id
ENABLE_BANKING_PRIVATE_KEY=%kernel.project_dir%/config/bank/e2e.pem
ENABLE_BANKING_BASE_URL=http://wiremock:8080/enablebanking
BANK_CALLBACK_URL=http://localhost/api/finance/bank-callback
