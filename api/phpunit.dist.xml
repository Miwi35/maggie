<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
>
    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
    </php>

    <testsuites>
        <!-- Cross-module: what the admin, the mobile app and the agent are
             entitled to rely on. Lives outside the module suites because the
             contract is the whole API, not one bundle's slice of it. -->
        <testsuite name="Contract">
            <directory>tests/Contract/</directory>
        </testsuite>
        <testsuite name="Calendar">
            <directory>modules/calendar/tests/</directory>
        </testsuite>
        <testsuite name="Core">
            <directory>modules/core/tests/</directory>
        </testsuite>
        <testsuite name="Cookbook">
            <directory>modules/cookbook/tests/</directory>
        </testsuite>
        <testsuite name="Grocery">
            <directory>modules/grocery/tests/</directory>
        </testsuite>
        <testsuite name="Notification">
            <directory>modules/notification/tests/</directory>
        </testsuite>
        <testsuite name="Finance">
            <directory>modules/finance/tests/</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>elasticsearch</group>
        </exclude>
    </groups>

    <source>
        <include>
            <directory>src/</directory>
            <directory>modules/calendar/src/</directory>
            <directory>modules/core/src/</directory>
            <directory>modules/cookbook/src/</directory>
            <directory>modules/grocery/src/</directory>
            <directory>modules/notification/src/</directory>
            <directory>modules/finance/src/</directory>
        </include>
        <exclude>
            <file>src/Kernel.php</file>
            <directory>src/DataFixtures/</directory>
        </exclude>
    </source>
</phpunit>
