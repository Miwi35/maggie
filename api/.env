APP_ENV=dev
APP_DEBUG=1
APP_SECRET=!ChangeMe!
DATABASE_URL="postgresql://maggie:maggie@database:5432/maggie?serverVersion=16"
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|maggie\.local)(:[0-9]+)?$'
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://maggie.local/.well-known/mercure
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
GOOGLE_CLIENT_ID=945014393623-rr1ja004uel8ml327e0gg0vsf51o2ajk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PASTE_YOUR_SECRET_HERE
GOOGLE_REDIRECT_URI=https://localhost/api/auth/google/callback
ADMIN_URL=https://maggie.local/admin
SERVICE_TOKEN=change-me-to-a-random-secret
ELASTICSEARCH_URL=http://elasticsearch:9200
CIQUAL_SERVICE_URL=http://ciqual:8002
GOOGLE_WEBHOOK_URL=https://maggie.example.com/api/calendar/google/webhook
GOOGLE_WEBHOOK_TOKEN=change-me-to-a-random-webhook-secret

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=https://example.com/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|maggie\.local)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Real value lives in the gitignored api/.env.local (dev) and k8s secrets (prod).
JWT_PASSPHRASE=change-me-set-in-env-local-or-k8s-secret
###< lexik/jwt-authentication-bundle ###

###> maggie/bank-sync ###
# Application id is public: it travels as the JWT key id.
ENABLE_BANKING_APPLICATION_ID=
# Signing key — never committed; see config/bank/ locally and the k8s secret in production.
ENABLE_BANKING_PRIVATE_KEY=%kernel.project_dir%/config/bank/enablebanking.pem
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
# Must match the redirect URL whitelisted with the provider, character for character.
BANK_CALLBACK_URL=https://maggieai.fr/api/finance/bank-callback
###< maggie/bank-sync ###
