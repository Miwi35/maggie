# Load guard thresholds for the worktree-local tasks (task wt:*).
#
# Not hard-coded, so they can be tuned without touching the tasks. Edit them
# here: exporting the variable does NOT override the container limits, because
# Task's `dotenv` wins over the process environment for template values. The
# guard thresholds do honour an export, since guard.sh reads them from the
# environment — an inconsistency worth knowing rather than relying on.
#
# The machine these were chosen for: 16 cores, 30 GB RAM, ~23 dev containers
# already running and roughly 4 GB available at rest.

# Refuse to start below this much available RAM (MemAvailable, in MB).
# A PHPStan run peaks around 1 GB; 3 GB leaves room for it and for whatever
# else the machine is doing.
WT_MIN_AVAILABLE_MB=3072

# Refuse to start when the 1-minute load average exceeds this fraction of the
# core count. At 16 cores that is a load of 12.8.
WT_MAX_LOAD_RATIO=0.8

# The e2e stack is eleven containers, ~3 GiB of limits: `task e2e:up` asks for
# more headroom than a wt task does (MAG-137). Not applied on CI. On a machine
# that sits at ~4 GB available at rest, like the one above, this means "stop
# something first, or let CI run the journey" — which is the intent.
E2E_MIN_AVAILABLE_MB=5120

# How many other worktrees may keep a stack up (`task wt:up`) before a new
# command waits, then falls back to CI. Each one is a Postgres, small — the
# cap is there for the forgotten ones.
WT_MAX_STACKS=3

# A worktree stack with no wt:* launch for this long is removed, by the guard
# and by the reaper `wt:up` starts. The reaper polls once a minute, so a
# forgotten stack is gone in under IDLE + 1 minute.
WT_IDLE_MINUTES=15

# How long to wait for the machine to free up before giving up. Deliberately
# short: the fallback is CI, not a queue.
WT_GUARD_RETRIES=6
WT_GUARD_WAIT_SECONDS=20

# Per-container limits. One task must not be able to take the machine down.
WT_MEMORY=2g
WT_CPUS=4
# The kept Postgres, which holds an in-memory test database.
WT_DB_MEMORY=512m
