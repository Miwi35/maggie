# =============================================================================
# Environment
# =============================================================================
.env
.env.local
.env.*.local
!.env.example
!api/.env

# =============================================================================
# IDE
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db

# =============================================================================
# API (Symfony)
# =============================================================================
api/var/
api/vendor/
api/public/bundles/
api/.php-cs-fixer.cache
api/phpunit.xml

# =============================================================================
# Admin (React)
# =============================================================================
admin/node_modules/
admin/dist/
admin/.vite/
admin/tsconfig.tsbuildinfo

# =============================================================================
# Agent (Python)
# =============================================================================
agent/**/__pycache__/
agent/.venv/
agent/*.egg-info/
agent/.pytest_cache/
agent/.mypy_cache/
agent/.ruff_cache/
agent/data/
# What `task e2e:eval --report` writes: the agent container mounts ./agent, so
# its report lands here.
agent/eval-report.md

# =============================================================================
# Mobile (Android)
# =============================================================================
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties
mobile/.idea/
mobile/release.keystore
mobile/keystore.properties

# =============================================================================
# Docker volumes (if mounted locally)
# =============================================================================
.docker-data/

# =============================================================================
# TLS certificates (machine-specific, generated by mkcert)
# =============================================================================
.docker/traefik/certs/*.pem

# =============================================================================
# Logs
# =============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# Testing
# =============================================================================
api/var/coverage/
admin/coverage/
.phpunit.result.cache

# =============================================================================
# Wake word models (OpenWakeWord ONNX — binary blobs, train locally)
# =============================================================================
mobile/app/src/main/assets/*.onnx
mobile/app/src/main/assets/*.onnx.data
admin/public/openwakeword/

# =============================================================================
# Kubernetes secrets (real values — only commit the .example)
# =============================================================================
infra/k8s/secrets.yaml

# =============================================================================
# AI tools
# =============================================================================
.claude/settings.local.json
# Scratch scripts, except the prompt lab: its scenarios are what `/prompt-lab`
# and `task e2e:eval` both read (MAG-95), so they belong in the repository.
# A negation cannot re-include a path inside an ignored *directory*, hence
# `/scripts/*` rather than `/scripts`.
#
# The whole prompt-lab directory and not just `scenarios/`, deliberately: the
# tooling `/prompt-lab` documents lives beside them (mcp-session.sh, MAG-136),
# and narrowing this would have git silently refuse to add it.
/scripts/*
!/scripts/prompt-lab/
!/scripts/agent-guard/
# JWT cached by `mcp-session.sh login`
/scripts/prompt-lab/.token

# =============================================================================
# E2E stack
# =============================================================================
# Task's fingerprint cache for e2e:install and the key generators
.task/
# Written by app:e2e:seed — reference → id map, one per run
api/var/e2e/
# The Playwright harness (MAG-97): dependencies and what a run leaves behind —
# traces, videos and screenshots of failures. CI uploads them as an artifact.
e2e/web/node_modules/
e2e/web/playwright-report/
e2e/web/blob-report/
e2e/web/test-results/
# The Maestro harness (MAG-98): the JUnit report and the screenshots of a failed
# flow. CI uploads them too; the CLI itself lives under .e2e-cache/ below.
e2e/mobile/report/

# E2E stack caches (MAG-135)
.e2e-cache/
# Built from the committed XML by `task e2e:ciqual:db`, in three seconds — the
# `dev` image the stack runs bakes no database, and the bind mount would hide
# one anyway (MAG-101). 13 MB of generated bytes; never committed.
ciqual/db/*.db
ciqual/db/*.db-shm
ciqual/db/*.db-wal

# The APK `e2e/mobile/build-apk.sh` leaves for run.sh (MAG-233)
e2e/mobile/apk/
