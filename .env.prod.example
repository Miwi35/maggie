# Maggie v3 — Production Environment Variables
# Copy to /opt/maggie/.env.prod on VPS and fill in real values

# =============================================================================
# Symfony / PHP
# =============================================================================
APP_SECRET=change-me-to-a-random-string
TRUSTED_PROXIES=REMOTE_ADDR

# =============================================================================
# Database
# =============================================================================
POSTGRES_USER=maggie
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=maggie
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=17

# =============================================================================
# Mercure
# =============================================================================
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://maggieai.fr/.well-known/mercure
# At least 32 bytes (HS256): the API refuses to start below that. Generate: openssl rand -hex 32
MERCURE_JWT_SECRET=replace-with-openssl-rand-hex-32-output

# =============================================================================
# CORS
# =============================================================================
CORS_ALLOW_ORIGIN='^https://maggieai\.fr$'

# =============================================================================
# RabbitMQ
# =============================================================================
RABBITMQ_DEFAULT_USER=maggie
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/%2f/messages

# =============================================================================
# Google OAuth
# =============================================================================
GOOGLE_CLIENT_ID=945014393623-rr1ja004uel8ml327e0gg0vsf51o2ajk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
GOOGLE_REDIRECT_URI=https://maggieai.fr/api/auth/google/callback
ADMIN_URL=https://maggieai.fr/admin

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=maggie-jwt-prod

# =============================================================================
# Service Token (agent → API authentication)
# =============================================================================
SERVICE_TOKEN=change-me-to-a-random-secret

# =============================================================================
# Agent Hub (Python)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=sk-...
MCP_SERVER_URL=http://nginx/_mcp

# =============================================================================
# Image tag (set by CD pipeline, or override manually)
# =============================================================================
IMAGE_TAG=latest
