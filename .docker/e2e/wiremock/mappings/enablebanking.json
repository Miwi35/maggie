    {
      "name": "Balances for the savings account",
      "request": {
        "method": "GET",
        "urlPathPattern": "/enablebanking/accounts/e2e-account-savings/balances"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "balances": [
            {
              "name": "Booked",
              "balance_amount": {
                "currency": "EUR",
                "amount": "4200.00"
              },
              "balance_type": "CLBD"
            }
          ]
        }
      }
