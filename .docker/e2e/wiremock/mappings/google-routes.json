{
  "mappings": [
    {
      "name": "Google Routes — the walk from the dentist's parking (48.119, -1.6672), 3 min",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/google-routes/directions/v2:computeRoutes",
        "bodyPatterns": [
          { "matchesJsonPath": { "expression": "$.travelMode", "equalTo": "WALK" } },
          { "matchesJsonPath": { "expression": "$.origin.location.latLng.latitude", "equalTo": "48.119" } }
        ]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "routes": [{ "duration": "180s" }] }
      }
    },
    {
      "name": "Google Routes — any other walk, 4 min",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/google-routes/directions/v2:computeRoutes",
        "bodyPatterns": [{ "matchesJsonPath": { "expression": "$.travelMode", "equalTo": "WALK" } }]
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "routes": [{ "duration": "240s" }] }
      }
    },
    {
      "name": "Google Routes — any drive, 14 min",
