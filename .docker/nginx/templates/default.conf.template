upstream php-upstream {
    server php:9000;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};

    root /var/www/api/public;
    index index.php;

    # Prevent nginx from injecting http:// in redirects (Traefik terminates TLS)
    absolute_redirect off;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Gzip compression. The API answers Hydra as application/ld+json: without it
    # in the list, docs.jsonld (184 KB) leaves uncompressed at every start (MAG-546).
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/ld+json application/hal+json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml application/manifest+json;
    gzip_min_length 1000;

    # ==========================================================================
    # Root redirect → Admin
    # ==========================================================================
    location = / {
        return 302 /admin;
    }

    # ==========================================================================
    # Admin SPA (React)
    # ==========================================================================
    # `add_header` in a location replaces every header inherited from the server
    # block, so each location below repeats the security headers.

    # index.html names the hashed files of the current build: the browser asks
    # again each time (ETag makes it a 304), so a deploy is seen at once.
    location = /admin {
        root /var/www;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        try_files /admin/index.html =404;
    }

    # Vite puts a content hash in every file name here: a file never changes under
    # its name. A missing one is a 404, never index.html served as JavaScript — and
    # that 404 carries no cache header (no `always`), or it would be cached for a year.
    location /admin/assets/ {
        root /var/www;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        try_files $uri =404;
    }

    location /admin/ {
        root /var/www;
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        try_files $uri /admin/index.html;
    }

    # ==========================================================================
    # Legal pages — public by design: the bank data provider shows these to the
    # user during the consent journey, so they must answer without auth.
    # ==========================================================================
    location = /privacy {
        try_files /legal/privacy.html =404;
    }

    location = /terms {
        try_files /legal/terms.html =404;
    }

    # ==========================================================================
    # API Routes (Symfony)
    # ==========================================================================
    location /api {
        try_files $uri /index.php$is_args$args;
    }

    # Symfony bundles (API Platform assets, etc.)
    location /bundles {
        try_files $uri =404;
    }

    # ==========================================================================
    # MCP Server (Symfony MCP Bundle)
    # ==========================================================================
    location /_mcp {
        try_files $uri /index.php$is_args$args;
    }

    # PHP-FPM handling
    location ~ ^/index\.php(/|$) {
        fastcgi_pass php-upstream;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;

        # Performance
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;

        internal;
    }

    # Return 404 for all other PHP files
    location ~ \.php$ {
        return 404;
    }

    # Favicon fallback (prevent 404 logs)
    location = /favicon.ico {
        log_not_found off;
        access_log off;
        return 204;
    }

    # Deny access to sensitive files
    location ~ /\. {
        deny all;
    }
}
