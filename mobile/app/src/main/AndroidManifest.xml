<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- « Pars maintenant » (MAG-658): the departure alert opens over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- « Partir à l'heure » (MAG-651): asked only when the owner turns the switch on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- The service that follows the position while the owner moves or drives (MAG-666). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <queries>
        <intent><action android:name="android.settings.VOICE_INPUT_SETTINGS" /></intent>
        <intent><action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" /></intent>
    </queries>

    <application
        android:name=".MaggieApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Maggie"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Maggie">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links (MAG-28). Not BROWSABLE: a web page has no business opening the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="${deepLinkScheme}" />
            </intent-filter>
        </activity>

        <activity
            android:name=".voice.AssistantActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:launchMode="singleTask"
            android:taskAffinity="com.maggie.app.assistant"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- « Pars maintenant » (MAG-658): opened by the departure notification only, over the lock screen. -->
        <activity
            android:name=".ui.screens.departure.DepartureActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="com.maggie.app.departure"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <service
            android:name=".data.fcm.MaggieFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The buttons of a push notification, and the alarm that brings a postponed one back (MAG-29). Never exported: only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".data.fcm.PushActionReceiver"
            android:exported="false" />

        <!-- Leaving a car, then standing on one's feet (MAG-651). Never exported: only the app's own PendingIntent reaches it. -->
        <receiver
            android:name=".data.location.ActivityTransitionReceiver"
            android:exported="false" />

        <!-- The fixes other apps obtain, delivered for free (MAG-666). Never exported: only the app's own PendingIntent reaches it. -->
        <receiver
            android:name=".data.location.PassiveLocationReceiver"
            android:exported="false" />

        <!-- The GPS for the length of a trip, on foot or at the wheel (MAG-666); started by the transitions or the car's connection. -->
        <service
            android:name=".data.location.TripService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".voice.MaggieVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".voice.MaggieVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
        </service>

        <!-- The engine behind the assistant role (MAG-216): without it Android refuses the voice interaction service. -->
        <service
            android:name=".voice.MaggieRecognitionService"
            android:exported="true"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Sentry would start itself from a ContentProvider; MaggieApp starts it
             instead, and only when the build carries a DSN (SentrySetup). -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
    </application>

</manifest>
